generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model WaitlistEntry {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  role          String
  language      String
  name          String?
  socialHandle  String?
  queuePosition Int
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
}
